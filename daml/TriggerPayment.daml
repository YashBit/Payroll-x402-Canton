module TriggerPayment where

import Daml.Script
import DA.Optional (fromSome)
import PayRoll.Employee

triggerPayment : Script ()
triggerPayment = script do
  -- Use Splice onboarded party
  let employerText = "app_user_quickstart-yashbharti-1::1220d19c5817f45ed90da1c93a7f6d5a20538458aeca7b15dfb9a7d9b30fb435a5b7"
  let employerParty = fromSome (partyFromText employerText)
  
  debug "Using Splice party: app_user_quickstart-yashbharti-1"
  
  -- Create Employee contract
  empCid <- submit employerParty $ createCmd Employee with
    employer = employerParty
    employeeId = "EMP001"
    salary = 1000.0
  
  debug "✓ Employee created"
  
  -- Exercise PaySalary choice to create PaymentRequest
  payReqCid <- submit employerParty $ exerciseCmd empCid PaySalary
  
  debug "✓ PaymentRequest created - Bridge should detect this!"
  
  return ()
